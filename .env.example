# ==============================================================
# Amanamoni Balaji Portfolio — Contact Form Environment Variables
# ==============================================================
#
# Follow these 3 simple steps to connect EmailJS to your contact form:
# 1. Sign up for a free EmailJS account at: https://www.emailjs.com/
# 2. Add an Email Service (Gmail / Outlook / SMTP):
#    - Note down your Service ID (e.g., "service_xxxxxxx")
# 3. Create an Email Template:
#    - Use variables: {{from_name}}, {{from_email}}, {{subject}}, {{message}}, {{submission_date}}
#    - Set 'To Email' to: amanamonibalaji1828@gmail.com
#    - Note down your Template ID (e.g., "template_xxxxxxx")
# 4. Copy your Public Key from Account Settings (e.g., "public_key_xxxxxxx")
#
# Create a file named '.env' in the project root and add your keys below:

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Recipient Email Configuration
VITE_RECIPIENT_EMAIL=amanamonibalaji1828@gmail.com
